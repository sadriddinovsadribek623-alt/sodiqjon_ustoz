                                <input type="text" x-model="modalData.subject" class="w-full px-4 py-2 rounded-lg border border-slate-200 text-sm focus:outline-none focus:border-indigo-600">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-500 mb-1">Baho (1 - 5)</label>
                                <select x-model="modalData.grade" class="w-full px-4 py-2 rounded-lg border border-slate-200 text-sm focus:outline-none focus:border-indigo-600 bg-white">
                                    <option value="5">5</option>
                                    <option value="4">4</option>
                                    <option value="3">3</option>
                                    <option value="2">2</option>
                                    <option value="1">1</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-500 mb-1">Sana</label>
                                <input type="date" x-model="modalData.day" class="w-full px-4 py-2 rounded-lg border border-slate-200 text-sm focus:outline-none focus:border-indigo-600">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-500 mb-1">Izoh (ixtiyoriy)</label>
                                <input type="text" x-model="modalData.comment" class="w-full px-4 py-2 rounded-lg border border-slate-200 text-sm focus:outline-none focus:border-indigo-600">
                            </div>
                        </div>
                    </template>

                    <!-- User Form -->
                    <template x-if="activeModal === 'user'">
                        <div class="space-y-4">
                            <div>
                                <label class="block text-xs font-bold text-slate-500 mb-1">Login (username)</label>
                                <input type="text" x-model="modalData.username" class="w-full px-4 py-2 rounded-lg border border-slate-200 text-sm focus:outline-none focus:border-indigo-600">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-500 mb-1">F.I.SH.</label>
                                <input type="text" x-model="modalData.fullName" class="w-full px-4 py-2 rounded-lg border border-slate-200 text-sm focus:outline-none focus:border-indigo-600">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-500 mb-1">Parol</label>
                                <input type="password" x-model="modalData.password" class="w-full px-4 py-2 rounded-lg border border-slate-200 text-sm focus:outline-none focus:border-indigo-600">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-500 mb-1">Rol</label>
                                <select x-model="modalData.role" class="w-full px-4 py-2 rounded-lg border border-slate-200 text-sm focus:outline-none focus:border-indigo-600 bg-white">
                                    <option value="teacher">O‘qituvchi (teacher)</option>
                                    <option value="admin">Administrator (admin)</option>
                                </select>
                            </div>
                        </div>
                    </template>

                </div>

                <div class="mt-6 flex justify-end gap-3">
                    <button @click="activeModal = null" class="px-4 py-2 bg-slate-100 text-slate-600 hover:bg-slate-200 rounded-lg text-sm font-bold transition">Bekor qilish</button>
                    <button @click="saveModalData()" class="px-5 py-2 bg-[#14B8A6] hover:bg-[#0d9488] text-white rounded-lg text-sm font-bold shadow-md transition">Saqlash</button>
                </div>

            </div>
        </div>
    </template>

    <script>
        function schoolApp() {
            return {
                isAuthenticated: false,
                currentUser: null,
                loginForm: { username: 'admin', password: 'admin123' },
                currentTab: 'dashboard',
                selectedClass: '7-A',
                selectedGroup: '1-guruh',
                classOptions: ['5-A', '6-A', '7-A', '7-B', '8-A', '9-A', '10-A', '11-A'],
                searchStudent: '',
                activeModal: null,
                modalData: {},
                currentDate: new Date().toLocaleDateString('uz-UZ'),

                // Database tables stored in localStorage
                users: [],
                students: [],
                attendance: [],
                notebooks: [],
                lateness: [],
                discipline: [],
                lessons: [],
                grades: [],

                init() {
                    this.loadData();
                },

                loadData() {
                    // Default Users
                    const savedUsers = localStorage.getItem('sj_users');
                    if (savedUsers) {
                        this.users = JSON.parse(savedUsers);
                    } else {
                        this.users = [
                            { id: 1, username: 'admin', password: 'admin123', role: 'admin', fullName: 'Bosh administrator' },
                            { id: 2, username: 'teacher', password: 'teacher123', role: 'teacher', fullName: 'O‘qituvchi' }
                        ];
                        this.saveToStorage('sj_users', this.users);
                    }

                    // Default Students
                    const savedStudents = localStorage.getItem('sj_students');
                    if (savedStudents) {
                        this.students = JSON.parse(savedStudents);
                    } else {
                        this.students = [
                            { id: 1, fullName: 'Alisher Navoiy', className: '7-A', groupName: '1-guruh', phone: '+998901234567' },
                            { id: 2, fullName: 'Zahiriddin Bobur', className: '7-A', groupName: '1-guruh', phone: '+998907654321' },
                            { id: 3, fullName: 'Amir Temur', className: '7-A', groupName: '2-guruh', phone: '+998935554433' }
                        ];
                        this.saveToStorage('sj_students', this.students);
                    }

                    ['attendance', 'notebooks', 'lateness', 'discipline', 'lessons', 'grades'].forEach(table => {
                        const val = localStorage.getItem('sj_' + table);
                        this[table] = val ? JSON.parse(val) : [];
                    });
                },

                saveToStorage(key, data) {
                    localStorage.setItem(key, JSON.stringify(data));
                },

                handleLogin() {
                    const found = this.users.find(u => u.username === this.loginForm.username && u.password === this.loginForm.password);
                    if (!found) {
                        alert("Foydalanuvchi nomi yoki parol noto‘g‘ri!");
                        return;
                    }
                    this.currentUser = found;
                    this.isAuthenticated = true;
                },

                logout() {
                    this.isAuthenticated = false;
                    this.currentUser = null;
                },

                get availableTabs() {
                    let tabs = [
                        { id: 'dashboard', name: 'Bosh sahifa', icon: '<i class="fa-solid fa-house"></i>' },
                        { id: 'students', name: 'O‘quvchilar', icon: '<i class="fa-solid fa-user-graduate"></i>' },
                        { id: 'attendance', name: 'Davomat', icon: '<i class="fa-solid fa-check"></i>' },
                        { id: 'notebooks', name: 'Daftari yo‘qlar', icon: '<i class="fa-solid fa-book"></i>' },
                        { id: 'lateness', name: 'Kech qolganlar', icon: '<i class="fa-solid fa-clock"></i>' },
                        { id: 'discipline', name: 'Tartib nazorati', icon: '<i class="fa-solid fa-flag"></i>' },
                        { id: 'lessons', name: 'Mavzu', icon: '<i class="fa-solid fa-bookmark"></i>' },
                        { id: 'grades', name: 'Baholar', icon: '<i class="fa-solid fa-star"></i>' }
                    ];
                    if (this.currentUser?.role === 'admin') {
                        tabs.push({ id: 'users', name: 'Foydalanuvchilar', icon: '<i class="fa-solid fa-gear"></i>' });
                    }
                    return tabs;
                },

                get currentTabName() {
                    const tab = this.availableTabs.find(t => t.id === this.currentTab);
                    return tab ? tab.name : 'Bosh sahifa';
                },

                get filteredStudents() {
                    if (!this.searchStudent) return this.students;
                    const term = this.searchStudent.toLowerCase();
                    return this.students.filter(s => s.fullName.toLowerCase().includes(term) || s.className.toLowerCase().includes(term));
                },

                get uniqueClassesCount() {
                    return [...new Set(this.students.map(s => s.className))].length;
                },

                get todayPresentCount() {
                    const todayStr = new Date().toISOString().split('T')[0];
                    return this.attendance.filter(a => a.day === todayStr && a.status === 'Keldi').length;
                },

                get todayGradesCount() {
                    const todayStr = new Date().toISOString().split('T')[0];
                    return this.grades.filter(g => g.day === todayStr).length;
                },

                get averageGradeText() {
                    if (this.grades.length === 0) return 'Hali baho kiritilmagan';
                    const sum = this.grades.reduce((acc, cur) => acc + Number(cur.grade), 0);
                    return (sum / this.grades.length).toFixed(2);
                },

                getStudentName(id) {
                    const st = this.students.find(s => s.id === Number(id));
                    return st ? st.fullName : 'Noma’lum';
                },

                getStudentClass(id) {
                    const st = this.students.find(s => s.id === Number(id));
                    return st ? st.className : '';
                },

                openModal(type) {
                    this.activeModal = type;
                    const todayStr = new Date().toISOString().split('T')[0];
                    this.modalData = { day: todayStr, grade: '5', minutes: 5, status: 'Keldi' };
                    if(type === 'user') {
                        this.modalData = { role: 'teacher' };
                    }
                },

                get modalTitle() {
                    const titles = {
                        student: 'Yangi o‘quvchi qo‘shish',
                        attendance: 'Davomat belgilash',
                        notebook: 'Daftar olib kelmagan',
                        lateness: 'Kechikishni qayd etish',
                        discipline: 'Intizomiy qayd',
                        lesson: 'Dars mavzusini qo‘shish',
                        grade: 'Baho qo‘yish',
                        user: 'Foydalanuvchi qo‘shish'
                    };
                    return titles[this.activeModal] || '';
                },

                saveModalData() {
                    const type = this.activeModal;
                    if (type === 'student') {
                        if (!this.modalData.fullName || !this.modalData.className) {
                            alert("Iltimos, ism va sinfni kiriting!");
                            return;
                        }
                        const newItem = {
                            id: Date.now(),
                            fullName: this.modalData.fullName,
                            className: this.modalData.className,
                            groupName: this.modalData.groupName || '1-guruh',
                            phone: this.modalData.phone || ''
                        };
                        this.students.push(newItem);
                        this.saveToStorage('sj_students', this.students);
                    } else if (type === 'user') {
                        if (!this.modalData.username || !this.modalData.fullName || !this.modalData.password) {
                            alert("Barcha maydonlarni to‘ldiring!");
                            return;
                        }
                        const newItem = {
                            id: Date.now(),
                            username: this.modalData.username,
                            fullName: this.modalData.fullName,
                            password: this.modalData.password,
                            role: this.modalData.role
                        };
                        this.users.push(newItem);
                        this.saveToStorage('sj_users', this.users);
                    } else {
                        // General record mapping
                        const tableMap = {
                            attendance: 'attendance',
                            notebook: 'notebooks',
                            lateness: 'lateness',
                            discipline: 'discipline',
                            lesson: 'lessons',
                            grade: 'grades'
                        };
                        const tableName = tableMap[type];
                        if(tableName) {
                            const newItem = { id: Date.now(), ...this.modalData };
                            this[tableName].push(newItem);
                            this.saveToStorage('sj_' + tableName, this[tableName]);
                        }
                    }
                    this.activeModal = null;
                },

                deleteItem(table, id) {
                    if (confirm("Haqiqatan ham ushbu yozuvni o‘chirmoqchimisiz?")) {
                        this[table] = this[table].filter(item => item.id !== id);
                        this.saveToStorage('sj_' + table, this[table]);
                    }
                }
            }
        }
    </script>
</body>
</html>
